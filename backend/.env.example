# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Database ──────────────────────────────────────────────
# Default: SQLite (no setup needed — file created automatically)
# PostgreSQL: uncomment and fill in your credentials
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudbrain
DATABASE_URL=sqlite:///./cloudbrain.db

# ── AI Provider ───────────────────────────────────────────
# Optional: set your Gemini API key to enable LLM-powered RCA and Copilot.
# Without a key, CloudBrain uses its built-in rule-based analysis engine.
GEMINI_API_KEY=

# ── Sandbox ───────────────────────────────────────────────
# URL of the demo app inside the Docker sandbox.
# Change only if you modified docker-compose.yml port mappings.
SANDBOX_DEMO_URL=http://localhost:5050
